          <mxGeometry x="20" y="190" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="gitagent run（直接執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="adapters">
          <mxGeometry x="20" y="230" width="320" height="35" as="geometry" />
        </mxCell>

        <mxCell id="audit" value="Compliance / Audit&#xa;FINRA · SR 11-7 · SEC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="430" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="load / validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="repo" target="cli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="memory / learn → PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="cli" target="hitl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="merge → commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="hitl" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="on push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="repo" target="ci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="cli" target="adapters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="audit report&#xa;(git log / blame)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="cli" target="audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
