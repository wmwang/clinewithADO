  <diagram name="phased-rollout">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Phased Rollout — 四階段落地順序" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每階段獨立評估，可隨時煞車或調整方向" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="axis" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="420" as="sourcePoint" />
            <mxPoint x="1320" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="axisLabel" value="時間 →" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1240" y="430" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Phase 1&#xa;&#xa;/接單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1d" value="• 風險：低&#xa;• 有感：立即&#xa;• 輸入：work item ID&#xa;• 輸出：context 包 + branch&#xa;• 為何先做：最快驗證價值" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1r" value="🟢 LOW RISK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Phase 2&#xa;&#xa;pr-knowledge&#xa;初版抽取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2d" value="• 風險：低-中&#xa;• 有感：漸進（需資料）&#xa;• 輸入：歷史 PR comments&#xa;• 輸出：rule base&#xa;• 為何現在：可與 P1 並行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="260" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2r" value="🔵 LOW-MED RISK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Phase 3&#xa;&#xa;/pr-review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3d" value="• 風險：中&#xa;• 依賴：P2 rule 量&#xa;• 輸入：diff / PR + rule base&#xa;• 輸出：預審建議 / PR 意見&#xa;• 為何現在：有 rule 才有用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3r" value="🟠 MED RISK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="750" y="450" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Phase 4&#xa;&#xa;/pr-auto-fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4d" value="• 風險：高（會 push code）&#xa;• 依賴：P3 穩定後&#xa;• 輸入：PR active comments&#xa;• 輸出：patch → 人 gate → push&#xa;• 為何最後：人 gate 設計最吃經驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="260" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4r" value="🔴 HIGH RISK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1050" y="450" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dep12" value="並行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;fontSize=11;fontStyle=2;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep23" value="依賴" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep34" value="依賴" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="metric" value="📊 建議追蹤指標：&#xa;• 開發起手時間（assigned → first commit）&#xa;• PR 循環數（comment → approved round）&#xa;• Review comment 類型分布（mechanical / judgment）&#xa;• Skill 週調用次數&#xa;• pr-knowledge rule 命中率" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="brake" value="⚠️ 每階段獨立評估&#xa;&#xa;• 未達效益門檻：暫停／放棄&#xa;• 風險高於預期：煞車回溯&#xa;• 意外發現價值：優先擴張&#xa;• 團隊 adoption 不足：回到 Phase 1 擴散" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="540" width="500" height="130" as="geometry" />
        </mxCell>
      </root>
